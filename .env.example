# --- Postgres ---
# User has an existing local Postgres. Fill in real credentials.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/jaroche?schema=public"

# --- Server ---
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# --- Auth (JWT) ---
# Generate with: openssl rand -hex 64
JWT_ACCESS_SECRET="replace-with-64-char-hex"
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET="replace-with-different-64-char-hex"
JWT_REFRESH_TTL=7d
BCRYPT_ROUNDS=12

# --- Stripe (test mode) ---
# Get from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_..."
# Get from `stripe listen --forward-to localhost:4000/api/stripe/webhook`
STRIPE_WEBHOOK_SECRET="whsec_..."

# --- Client ---
# Used only if you bypass the Next /api/* rewrite proxy
NEXT_PUBLIC_API_BASE=/api
